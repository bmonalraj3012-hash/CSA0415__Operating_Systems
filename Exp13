#include <stdio.h>

int main() {
    int nb, np, i, j, choice;
    int block[20], process[20], used[20], alloc[20];

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for (i = 0; i < nb; i++) {
        scanf("%d", &block[i]);
        used[i] = 0;
    }

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for (i = 0; i < np; i++) {
        scanf("%d", &process[i]);
        alloc[i] = -1;
    }

    printf("1.First Fit  2.Best Fit  3.Worst Fit\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    for (i = 0; i < np; i++) {
        int idx = -1;

        for (j = 0; j < nb; j++) {
            if (!used[j] && block[j] >= process[i]) {
                if (choice == 1) {
                    idx = j;
                    break;
                } else if (choice == 2) {
                    if (idx == -1 || block[j] < block[idx])
                        idx = j;
                } else if (choice == 3) {
                    if (idx == -1 || block[j] > block[idx])
                        idx = j;
                }
            }
        }

        if (idx != -1) {
            alloc[i] = idx;
            used[idx] = 1;
        }
    }

    printf("\nProcess\tSize\tBlock\n");
    for (i = 0; i < np; i++) {
        if (alloc[i] == -1)
            printf("P%d\t%d\tNot allocated\n",
                   i + 1, process[i]);
        else
            printf("P%d\t%d\t%d\n",
                   i + 1, process[i], alloc[i] + 1);
    }

    return 0;
}
