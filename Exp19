#include <stdio.h>

int main() {
    int n, m, i, j, count = 0;
    int alloc[10][10], max[10][10];
    int need[10][10], avail[10], finish[10] = {0};
    int safe[10], found;

    printf("Enter number of processes and resources: ");
    scanf("%d%d", &n, &m);

    printf("Enter Allocation matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < m; j++)
            scanf("%d", &alloc[i][j]);

    printf("Enter Maximum matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < m; j++) {
            scanf("%d", &max[i][j]);
            need[i][j] = max[i][j] - alloc[i][j];

            if (need[i][j] < 0) {
                printf("Invalid allocation or maximum\n");
                return 1;
            }
        }

    printf("Enter Available resources:\n");
    for (j = 0; j < m; j++)
        scanf("%d", &avail[j]);

    while (count < n) {
        found = 0;

        for (i = 0; i < n; i++) {
            if (finish[i])
                continue;

            for (j = 0; j < m; j++)
                if (need[i][j] > avail[j])
                    break;

            if (j == m) {
                for (j = 0; j < m; j++)
                    avail[j] += alloc[i][j];

                safe[count++] = i;
                finish[i] = 1;
                found = 1;
            }
        }

        if (!found)
            break;
    }

    if (count == n) {
        printf("System is in a safe state.\nSafe sequence: ");
        for (i = 0; i < n; i++)
            printf("P%d ", safe[i]);
        printf("\n");
    } else {
        printf("System is not in a safe state.\n");
    }

    return 0;
}
