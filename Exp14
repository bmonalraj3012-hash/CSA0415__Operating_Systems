#include <stdio.h>
#include <string.h>

int main() {
    char files[20][50], name[50];
    int n = 0, choice, i, found;

    while (1) {
        printf("\n1.Create File  2.List Files  3.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            if (n == 20) {
                printf("Directory full\n");
                continue;
            }

            printf("Enter file name: ");
            scanf("%49s", name);
            found = 0;

            for (i = 0; i < n; i++)
                if (strcmp(files[i], name) == 0)
                    found = 1;

            if (found)
                printf("File already exists\n");
            else {
                strcpy(files[n++], name);
                printf("File created\n");
            }
        } else if (choice == 2) {
            printf("Files in directory:\n");
            for (i = 0; i < n; i++)
                printf("%s\n", files[i]);
        } else if (choice == 3) {
            break;
        } else {
            printf("Invalid choice\n");
        }
    }

    return 0;
}
