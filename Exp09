#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
    int id = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0600);
    char *data;

    if (id == -1) {
        perror("shmget");
        return 1;
    }

    data = (char *)shmat(id, NULL, 0);
    if (data == (char *)-1) {
        perror("shmat");
        shmctl(id, IPC_RMID, NULL);
        return 1;
    }

    strcpy(data, "Hello from shared memory!");

    pid_t pid = fork();

    if (pid == -1) {
        perror("fork");
        shmdt(data);
        shmctl(id, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        printf("Child received: %s\n", data);
        shmdt(data);
        _exit(0);
    } else {
        wait(NULL);
        shmdt(data);
        shmctl(id, IPC_RMID, NULL);
    }

    return 0;
}
